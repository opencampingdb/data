{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/opencampingdb/data/schema/place.schema.json",
  "title": "Open Camping DB place record",
  "description": "One file per place at places/<last 2 characters of id, lower case>/<id>.json. No key outside this schema is allowed.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "kind", "group", "location", "osm", "facts", "status", "rating", "fact_sources", "updated"],
  "properties": {
    "id": {
      "description": "ocdb_ followed by a ULID. Assigned once, never reused.",
      "type": "string",
      "pattern": "^ocdb_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "name": {
      "description": "Name from OSM, or null when the place has none.",
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 300
    },
    "kind": {
      "description": "What the place is. The codes of schema/kinds.json: the OTWD site_types vocabulary plus campground and picnic_site.",
      "enum": [
        "free_camp",
        "paid_campground",
        "caravan_park",
        "national_park_campsite",
        "state_forest_campsite",
        "showground",
        "rest_area",
        "dump_point",
        "drinking_water_point",
        "public_toilet",
        "public_shower",
        "laundromat",
        "information_centre",
        "attraction",
        "lookout",
        "swimming_spot",
        "boat_ramp",
        "fuel",
        "lpg_refill_swap",
        "mechanic",
        "hospital_emergency",
        "ferry_terminal",
        "campground",
        "picnic_site"
      ]
    },
    "group": {
      "description": "The kind's group, as listed in schema/kinds.json.",
      "enum": ["overnight", "utility", "services", "attraction", "emergency", "transport"]
    },
    "location": {
      "description": "Node position, or the centroid of a closed way or multipolygon relation. At most 6 decimal places.",
      "type": "object",
      "additionalProperties": false,
      "required": ["lat", "lon"],
      "properties": {
        "lat": {"type": "number", "minimum": -90, "maximum": 90},
        "lon": {"type": "number", "minimum": -180, "maximum": 180}
      }
    },
    "osm": {
      "description": "The OSM object this record came from, or null when it is not from OSM.",
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "id", "version"],
          "properties": {
            "type": {"enum": ["node", "way", "relation"]},
            "id": {"type": "integer", "minimum": 1},
            "version": {"type": "integer", "minimum": 0}
          }
        }
      ]
    },
    "facts": {
      "description": "Every key is optional. Values come from OSM tags or accepted feedback.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fee": {"type": "boolean"},
        "power": {"type": "boolean"},
        "pets": {"enum": ["yes", "leashed", "no"]},
        "tents": {"type": "boolean"},
        "caravans": {"type": "boolean"},
        "toilets": {"type": "boolean"},
        "showers": {"type": "boolean"},
        "drinking_water": {"type": "boolean"},
        "dump_station": {"type": "boolean"},
        "max_stay": {"type": "string", "minLength": 1, "maxLength": 100},
        "opening_hours": {"type": "string", "minLength": 1, "maxLength": 255},
        "website": {"type": "string", "pattern": "^https?://", "maxLength": 500},
        "phone": {"type": "string", "minLength": 1, "maxLength": 100},
        "access": {
          "description": "Road access: the vehicle needed to get there.",
          "enum": ["2wd", "awd", "4wd", "unknown"]
        },
        "entry": {
          "description": "Who may stay, from OSM access=*.",
          "enum": ["public", "customers", "permit", "private"]
        },
        "water_type": {
          "description": "For a drinking_water_point: tank_fill (a tap for filling tanks, amenity=water_point) or fountain (amenity=drinking_water).",
          "enum": ["tank_fill", "fountain"]
        }
      }
    },
    "status": {
      "enum": ["open", "reported_closed", "closed"]
    },
    "rating": {
      "description": "From accepted reviews, or null when there are none.",
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["count", "mean"],
          "properties": {
            "count": {"type": "integer", "minimum": 1},
            "mean": {"type": "number", "minimum": 1, "maximum": 5}
          }
        }
      ]
    },
    "fact_sources": {
      "description": "Where each value came from. Has exactly the keys of facts, plus optionally name and location. A missing name or location entry means OSM.",
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^(fee|power|pets|tents|caravans|toilets|showers|drinking_water|dump_station|max_stay|opening_hours|website|phone|access|entry|water_type|name|location)$": {
          "enum": ["osm", "feedback"]
        }
      }
    },
    "updated": {
      "description": "When the record last changed, UTC.",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  }
}
