{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/opencampingdb/data/schema/review.schema.json",
  "title": "Open Camping DB review",
  "description": "One line of reviews/<place id>.ndjson. No names, emails or device IDs, and no key outside this schema.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "place", "stars", "text", "visited", "created", "app"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^rev_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "place": {
      "type": "string",
      "pattern": "^ocdb_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "stars": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "text": {
      "type": "string",
      "maxLength": 2000
    },
    "visited": {
      "description": "Month of the visit, YYYY-MM.",
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
    },
    "created": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "app": {
      "description": "Short name of the app that sent the review.",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"
    }
  }
}
