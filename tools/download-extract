#!/usr/bin/env bash
# Downloads the Australia OSM extract to <dir>/australia-latest.osm.pbf and
# checks its md5. Tries Geofabrik first, then the OpenStreetMap France mirror
# when Geofabrik cannot be reached or its file fails the check: Geofabrik
# sometimes refuses connections from GitHub's runners.
#
# Writes the name of the server it used to <dir>/extract-source.txt, for the
# sync report. The mirror's copy is refused when its data is more than
# MAX_AGE_H hours old (default 72), or older than the newest OSM edit already
# in PLACES_DIR (default places/, from the folder it is run in), so a lagging
# mirror never undoes edits an earlier sync took in.
#
# Usage: tools/download-extract <dir>
# Env: USER_AGENT (required), GEOFABRIK_URL, MIRROR_URL, MAX_AGE_H, PLACES_DIR.
set -euo pipefail

dir="${1:?usage: tools/download-extract <dir>}"
: "${USER_AGENT:?USER_AGENT is not set}"
GEOFABRIK_URL="${GEOFABRIK_URL:-https://download.geofabrik.de/australia-oceania/australia-latest.osm.pbf}"
MIRROR_URL="${MIRROR_URL:-https://download.openstreetmap.fr/extracts/oceania/australia.osm.pbf}"
MAX_AGE_H="${MAX_AGE_H:-72}"
PLACES_DIR="$(cd "${PLACES_DIR:-places}" 2>/dev/null && pwd || true)"
out="australia-latest.osm.pbf"
cd "$dir"

fetch() { curl -fsSL -A "$USER_AGENT" --retry 3 --retry-delay 30 --retry-all-errors -o "$2" "$1"; }

# The md5 file names the file as the server calls it, so check against our name.
check_md5() { awk -v f="$out" '{ print $1 "  " f }' "$out.md5" | md5sum -c -; }

if fetch "$GEOFABRIK_URL" "$out" && fetch "$GEOFABRIK_URL.md5" "$out.md5" && check_md5; then
  echo "Geofabrik" > extract-source.txt
else
  echo "Geofabrik failed, trying the OpenStreetMap France mirror" >&2
  rm -f "$out" "$out.md5"
  state_url="${MIRROR_URL%.osm.pbf}.state.txt"
  fetch "$state_url" state.txt
  stamp="$(sed -n 's/^timestamp=//p' state.txt | tr -d '\\')"
  [ -n "$stamp" ] || { echo "the mirror's state file has no timestamp" >&2; exit 1; }
  age_h=$(( ( $(date -u +%s) - $(date -u -d "$stamp" +%s) ) / 3600 ))
  if [ "$age_h" -gt "$MAX_AGE_H" ]; then
    echo "the mirror's extract is from $stamp, $age_h hours old, over $MAX_AGE_H" >&2
    exit 1
  fi
  if [ -n "$PLACES_DIR" ]; then
    newest="$(python3 -I -c 'import glob, json, sys
print(max(((json.load(open(p)).get("osm") or {}).get("timestamp") or "" for p in glob.glob(sys.argv[1] + "/*/*.json")), default=""))' "$PLACES_DIR")"
    if [[ "$stamp" < "$newest" ]]; then
      echo "the mirror's extract is from $stamp, older than the newest OSM edit in places/ ($newest)" >&2
      exit 1
    fi
  fi
  fetch "$MIRROR_URL" "$out"
  fetch "$MIRROR_URL.md5" "$out.md5"
  check_md5
  echo "OpenStreetMap France mirror (data to $stamp)" > extract-source.txt
fi
ls -l "$out"
cat extract-source.txt
