<?xml version="1.0" encoding="UTF-8"?>
<!-- Hand-written test data for relations. The places are invented.
     Relation 4001 is a multipolygon camp site: its outer ring is split over
     two untagged ways (2101, 2102), and it has a square hole (way 2103) towards
     the north-west corner. Relation 4002 is tagged as a camp site but is a
     type=route relation, neither a multipolygon nor a site, so it is skipped. Way 2201 is a building
     and way 2202 is an untagged closed way: neither may reach the area
     builder. -->
